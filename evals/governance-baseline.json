{
  "schema_version": 1,
  "cases": [
    {
      "id": "workflow-is-task-scoped",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["TaskScopedProposalLoop", "Understand → Propose → Authorize → Execute → Verify → Report → Learn"]
    },
    {
      "id": "no-material-proposal-is-silent",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["沒有 MaterialProposal 時靜默通過 Propose 與 Authorize"]
    },
    {
      "id": "small-tasks-avoid-extra-docs",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["小型且驗收明確的任務不為流程額外建立文件"]
    },
    {
      "id": "scope-expansion-needs-authorization",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["範圍擴張", "必須取得明確授權"]
    },
    {
      "id": "unaccepted-proposals-are-not-persisted",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["未接受的提案不自動建立 issue、task、memory 或 HistoryRecord"]
    },
    {
      "id": "learning-needs-confirmation",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["仍須經使用者確認才能正式保存"]
    },
    {
      "id": "l0-remains-stack-neutral",
      "file": "core/constitution/rules.md",
      "must_contain": ["不把語言或框架限定寫入 L0"]
    },
    {
      "id": "implementation-review-gate",
      "file": "core/skills/implement/SKILL.md",
      "must_contain": ["mandatory code-review gate for behavioral changes", "Invoke the `code-review` Skill"]
    },
    {
      "id": "review-does-not-publish",
      "file": "core/skills/implement/SKILL.md",
      "must_contain": ["Do not commit, push, open a pull request"]
    },
    {
      "id": "candidate-code-is-never-executed",
      "file": "core/skills/skill-scout/SKILL.md",
      "must_contain": ["Never execute candidate scripts, hooks, installers, or downloaded code"]
    },
    {
      "id": "hook-is-optional",
      "file": "README.md",
      "must_contain": ["可選 pre-push Hook", "Hook 只提供本機提早回饋"]
    },
    {
      "id": "hook-does-not-replace-authority",
      "file": "README.md",
      "must_contain": ["不取代 CI、branch protection 或 L0 授權邊界"]
    },
    {
      "id": "external-integrations-are-classified-per-operation",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["依每次操作分類，不以產品名稱一次定性", "分類為 Source 本身不擴張既有授權"]
    },
    {
      "id": "source-access-does-not-authorize-actions",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["Source 的讀取權不自動授權後續 Action", "按 Action 邊界處理"]
    },
    {
      "id": "security-review-is-risk-triggered",
      "file": "core/skills/security-review/SKILL.md",
      "must_contain": ["materially affects a trust boundary or security control", "do not use as a generic checklist for unrelated or low-risk changes", "Review only"]
    },
    {
      "id": "security-findings-require-evidence",
      "file": "core/skills/security-review/SKILL.md",
      "must_contain": ["Reject findings that have no plausible path", "do not claim the whole system is secure"]
    },
    {
      "id": "roles-synced-constitution",
      "file": "core/constitution/rules.md",
      "must_contain": ["PM／SA／UX／SD／PG／QA agent 只做自己階段的事"]
    },
    {
      "id": "roles-synced-operating-model",
      "file": "vault/governance/operating-model.md",
      "must_contain": ["六個角色是可選能力，不是強制流水線："]
    },
    {
      "id": "roles-synced-readme",
      "file": "README.md",
      "must_contain": ["PM / SA / UX / SD / PG / QA 六個角色 agent"]
    },
    {
      "id": "roles-synced-project-claude-md",
      "file": "CLAUDE.md",
      "must_contain": [
        "`ux` — 使用者互動流程、介面狀態、易用性取捨",
        "`qa` — 獨立於實作者的測試涵蓋率與驗收驗證"
      ]
    },
    {
      "id": "roles-synced-fleet-readme",
      "file": "fleet/README.md",
      "must_contain": ["PM／SA／UX／SD／PG／QA 角色"]
    },
    {
      "id": "roles-synced-governance-wiring",
      "file": "scripts/ProjectD.GovernanceWiring.psm1",
      "must_contain": [
        "${bt}ux$bt（互動設計）",
        "${bt}qa$bt（獨立驗證）",
        "pm、sa、ux、sd、pg、qa 指引"
      ]
    },
    {
      "id": "vault-readme-no-stale-placeholder",
      "file": "vault/README.md",
      "must_not_contain": ["（待填）"]
    }
  ]
}
