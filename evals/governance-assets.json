  "coverage_exclusions": [
    {
      "id": "host-runtime-assets",
      "reason": "The repository cannot verify tools, MCP servers, plugins, credentials, or exact model versions dynamically supplied by each AI host.",
      "owner": "host-or-project-operator",
      "discovery_trigger": "Before enabling a new host integration or executing a host-provided high-risk capability, add a host/project inventory entry and run the same validator."
    },
    {
      "id": "host-hook-coverage",
      "reason": "Codex hosted and specialized tool paths may bypass repository hooks; Claude at-references and EndConversation are also outside hook coverage. Untrusted or disabled project hooks do not run, and side effects from concurrently launched matching hooks are outside this log. Repository contracts do not prove that a live host loaded the hooks.",
      "owner": "host-or-project-operator",
      "discovery_trigger": "Before claiming live durable-operation coverage, run an explicitly authorized host pilot and inventory every uncovered or opt-out tool path."
    },
    {
      "id": "runtime-policy-live-integration",
      "reason": "The Codex/Claude pre-effect hook supports current-policy task-scoped authorization envelopes; reads without an envelope remain advisory while effectful or unclassified calls fail closed. A trusted Codex CLI 0.152.1 Windows pilot using gpt-5.6-luna / medium verified the current-policy metadata bootstrap, built-in apply_patch workspace allow and out-of-scope shell deny paths. Other Codex models, Claude, other tool paths, recovery and cross-host behavior remain unverified live.",
      "owner": "projectD-core",
      "discovery_trigger": "After any runtime policy bundle change, or before extending coverage to another host, capability, tool path or recovery scenario, run an explicitly authorized live pilot for that boundary and capture metadata-only allow/deny and observable final-state evidence."
    }
  ],
