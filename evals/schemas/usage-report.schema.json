{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/usage-report.schema.json",
  "title": "projectD account-aware usage report",
  "description": "Deterministic daily/weekly report grouped by provider/account(alias)/device/environment/model. No email, organization, repository, path, prompt, or session/turn identifier may appear. Official provider quota/rate-limit state is kept in a separate top-level section from local token diagnostics -- they must never be merged into the same metric.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "generated_at",
    "period",
    "group_by",
    "rows",
    "quota_snapshots",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["local", "merged"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "group_by": { "enum": ["day", "week"] },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "quota_snapshots": {
      "type": "array",
      "items": { "type": "object" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "provider",
        "alias",
        "device_id",
        "environment",
        "model",
        "local_context",
        "run_count",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_creation_tokens",
        "estimated_cost_usd"
      ],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        },
        "provider": { "enum": ["codex", "claude"] },
        "alias": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "device_id": { "type": "string", "pattern": "^dev_[a-f0-9]{32}$" },
        "environment": { "enum": ["work", "home", "other"] },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "local_context": {
          "description": "Local-only diagnostic label (e.g. a project folder name or Codex thread title), present only in local-mode reports. Always null in merged-mode reports -- this field is dropped by construction before an event ever crosses the export gate or cross-device merge, so no merged row can carry it.",
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "run_count": { "type": "integer", "minimum": 1 },
        "input_tokens": { "$ref": "#/$defs/metric" },
        "cached_input_tokens": { "$ref": "#/$defs/metric" },
        "output_tokens": { "$ref": "#/$defs/metric" },
        "reasoning_tokens": { "$ref": "#/$defs/metric" },
        "cache_creation_tokens": { "$ref": "#/$defs/metric" },
        "estimated_cost_usd": { "$ref": "#/$defs/metric" }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "message", "provider", "device_id", "environment",
        "period", "metric", "observed_value", "baseline_value", "count"
      ],
      "properties": {
        "type": {
          "enum": [
            "unknown_identity", "account_mismatch", "data_gap",
            "anomalous_usage"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider": {
          "oneOf": [{ "enum": ["codex", "claude"] }, { "type": "null" }]
        },
        "device_id": {
          "oneOf": [
            { "type": "string", "pattern": "^dev_[a-f0-9]{32}$" },
            { "type": "null" }
          ]
        },
        "environment": {
          "oneOf": [
            { "enum": ["work", "home", "other"] },
            { "type": "null" }
          ]
        },
        "period": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string", "format": "date-time" },
                "end": { "type": "string", "format": "date-time" }
              }
            },
            { "type": "null" }
          ]
        },
        "metric": {
          "oneOf": [
            {
              "enum": [
                "input_tokens", "cached_input_tokens", "output_tokens",
                "reasoning_tokens", "cache_creation_tokens",
                "estimated_cost_usd"
              ]
            },
            { "type": "null" }
          ]
        },
        "observed_value": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "baseline_value": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "count": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        }
      }
    }
  }
}
