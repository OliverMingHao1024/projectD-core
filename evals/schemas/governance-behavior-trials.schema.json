{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/governance-behavior-trials.schema.json",
  "title": "projectD governance behavior trial trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trials"],
  "properties": {
    "schema_version": { "const": 1 },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "trial_id", "agent", "model", "harness", "events", "outcome", "final_state"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "trial_id": { "type": "string", "minLength": 1 },
          "agent": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "harness": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "items": { "$ref": "#/$defs/scalarMap" }
          },
          "outcome": { "$ref": "#/$defs/scalarMap" },
          "final_state": { "$ref": "#/$defs/scalarMap" }
        }
      }
    }
  },
  "$defs": {
    "scalarMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
    }
  }
}
