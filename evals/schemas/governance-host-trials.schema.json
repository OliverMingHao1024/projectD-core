{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/governance-host-trials.schema.json",
  "title": "projectD governance host trial envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "evidence_kind", "host", "model", "started_at", "completed_at", "provenance", "privacy", "metrics", "evaluation", "checkpoint"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "evidence_kind": { "enum": ["contract-fixture", "manual-authorized-import"] },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cli_version", "harness_id", "adapter_id", "adapter_version"],
      "properties": {
        "name": { "enum": ["codex", "claude"] },
        "cli_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$" },
        "harness_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "adapter_id": { "enum": ["codex-governance-adapter", "claude-governance-adapter"] },
        "adapter_version": { "const": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "codex" } } },
          "then": { "properties": { "adapter_id": { "const": "codex-governance-adapter" } } }
        },
        {
          "if": { "properties": { "name": { "const": "claude" } } },
          "then": { "properties": { "adapter_id": { "const": "claude-governance-adapter" } } }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "version_evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version_evidence": { "enum": ["contract-fixture", "user-supplied"] }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "import_transport", "model_execution_attested", "source_trials", "source_catalog"],
      "properties": {
        "authorization": { "enum": ["contract-fixture", "explicit-current-task"] },
        "import_transport": { "const": "structured-json" },
        "model_execution_attested": { "type": "boolean" },
        "source_trials": { "$ref": "#/$defs/sourceEvidence" },
        "source_catalog": { "$ref": "#/$defs/sourceEvidence" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_mode", "redaction_status", "contains_raw_prompt", "contains_chain_of_thought", "contains_secret_values", "contains_private_data"],
      "properties": {
        "content_mode": { "const": "metadata-only" },
        "redaction_status": { "const": "verified" },
        "contains_raw_prompt": { "const": false },
        "contains_chain_of_thought": { "const": false },
        "contains_secret_values": { "const": false },
        "contains_private_data": { "const": false }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "input_tokens", "output_tokens", "cost_usd", "approval_count"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "$ref": "#/$defs/countOrUnavailable" },
        "output_tokens": { "$ref": "#/$defs/countOrUnavailable" },
        "cost_usd": {
          "anyOf": [
            { "type": "number", "minimum": 0 },
            { "const": "unavailable" }
          ]
        },
        "approval_count": { "type": "integer", "minimum": 0 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "case_count", "passed_count", "high_risk_regressions"],
      "properties": {
        "passed": { "type": "boolean" },
        "case_count": { "type": "integer", "minimum": 1 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "high_risk_regressions": { "type": "integer", "minimum": 0 }
      }
    },
    "checkpoint": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "integrity"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "integrity": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" }
      }
    },
    "countOrUnavailable": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "const": "unavailable" }
      ]
    }
  }
}
