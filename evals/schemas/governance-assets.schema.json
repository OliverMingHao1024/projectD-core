{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/governance-assets.schema.json",
  "title": "projectD governance asset inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "owner", "coverage_exclusions", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "coverage_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "owner", "discovery_trigger"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "discovery_trigger": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "status", "risk_tier", "source", "capabilities", "controls", "related_eval_cases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["agent", "model", "skill_catalog", "tool", "mcp", "plugin", "credential", "data_source"] },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "disabled", "planned", "retired"] },
        "risk_tier": { "enum": ["low", "medium", "high", "critical"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference", "version"],
          "properties": {
            "type": { "enum": ["repository-local", "external"] },
            "reference": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write", "destructive", "open_world", "private_data", "untrusted_content", "external_communication"],
          "properties": {
            "read": { "type": "boolean" },
            "write": { "type": "boolean" },
            "destructive": { "type": "boolean" },
            "open_world": { "type": "boolean" },
            "private_data": { "type": "boolean" },
            "untrusted_content": { "type": "boolean" },
            "external_communication": { "type": "boolean" }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_policy", "isolation", "disable_procedure"],
          "properties": {
            "approval_policy": { "type": "string", "minLength": 1 },
            "isolation": { "type": "string", "minLength": 1 },
            "source_sink_policy": { "type": "string" },
            "disable_procedure": { "type": "string", "minLength": 1 }
          }
        },
        "credential_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "audience", "storage", "expiry_policy"],
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "audience": { "type": "string", "minLength": 1 },
            "storage": { "type": "string", "minLength": 1 },
            "expiry_policy": { "type": "string", "minLength": 1 }
          }
        },
        "related_eval_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
