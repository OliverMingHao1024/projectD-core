{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/governance-task-traces.schema.json",
  "title": "projectD privacy-preserving governance task traces",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "coverage_exclusions", "traces", "after_action_regressions"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "coverage_exclusions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "activation_trigger"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "reason": { "type": "string", "minLength": 1 },
          "activation_trigger": { "type": "string", "minLength": 1 }
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/trace" }
    },
    "after_action_regressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/afterActionRegression" }
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "task_ref", "case_id", "scenario_type", "source", "privacy", "runtime", "started_at", "completed_at", "limits", "events", "outcome", "final_state"],
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "task_ref": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "scenario_type": {
          "enum": ["prompt_injection", "memory_poisoning", "tool_misuse", "exfiltration", "credential_revoke_drill", "tool_disable_drill", "egress_deny_drill", "rollback_drill"]
        },
        "source": { "enum": ["synthetic", "incident-derived"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_mode", "redaction_status", "contains_raw_prompt", "contains_chain_of_thought", "contains_secret_values", "contains_private_data"],
          "properties": {
            "content_mode": { "const": "metadata-only" },
            "redaction_status": { "const": "verified" },
            "contains_raw_prompt": { "const": false },
            "contains_chain_of_thought": { "const": false },
            "contains_secret_values": { "const": false },
            "contains_private_data": { "const": false }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent", "model", "harness"],
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "harness": { "type": "string", "minLength": 1 }
          }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_actions"],
          "properties": { "max_actions": { "type": "integer", "minimum": 0 } }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/event" }
        },
        "outcome": { "$ref": "#/$defs/scalarMap" },
        "final_state": { "$ref": "#/$defs/scalarMap" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "previous_event_id", "occurred_at", "type", "classification", "target", "authorized", "external", "destructive", "result", "details_code"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_event_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "type": { "enum": ["untrusted_input_observed", "policy_decision", "tool_call", "memory_promotion", "control_action", "verification_result", "rollback_action"] },
        "classification": { "enum": ["source", "control", "action", "evidence"] },
        "target": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "authorized": { "type": "boolean" },
        "external": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "result": { "enum": ["observed", "blocked", "succeeded", "failed", "noop"] },
        "details_code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "control": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "afterActionRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_level", "summary", "trace_id", "case_id", "controls_exercised", "regression_status", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "evidence_level": { "enum": ["simulated", "verified"] },
        "summary": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "controls_exercised": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "regression_status": { "enum": ["active", "planned", "retired"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "scalarMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
    }
  }
}
