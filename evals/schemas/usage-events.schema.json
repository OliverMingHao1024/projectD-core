{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/usage-events.schema.json",
  "title": "projectD provider-neutral usage event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source_event_id",
    "session_id",
    "turn_id",
    "occurred_at",
    "provider",
    "identity",
    "model",
    "usage"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/eventId" },
    "source_event_id": { "$ref": "#/$defs/eventId" },
    "session_id": { "$ref": "#/$defs/eventId" },
    "turn_id": { "$ref": "#/$defs/eventId" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "provider": { "$ref": "#/$defs/provider" },
    "identity": { "$ref": "#/$defs/identity" },
    "model": { "$ref": "#/$defs/modelObservation" },
    "local_context": { "$ref": "#/$defs/localContext" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_creation_tokens",
        "estimated_cost_usd"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/tokenObservation" },
        "cached_input_tokens": { "$ref": "#/$defs/tokenObservation" },
        "output_tokens": { "$ref": "#/$defs/tokenObservation" },
        "reasoning_tokens": { "$ref": "#/$defs/tokenObservation" },
        "cache_creation_tokens": { "$ref": "#/$defs/tokenObservation" },
        "estimated_cost_usd": { "$ref": "#/$defs/costObservation" }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "provider": { "const": "codex" },
            "identity": {
              "properties": { "provider": { "const": "codex" } }
            }
          }
        },
        {
          "properties": {
            "provider": { "const": "claude" },
            "identity": {
              "properties": { "provider": { "const": "claude" } }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "provider": { "enum": ["codex", "claude"] },
    "localContext": {
      "description": "Local-only diagnostic hint (e.g. a project folder name or the operator's own session title) so a local-mode report can group usage by task. This field is intentionally outside the source-side export allowlist (usage-export-batch.schema.json) and outside usage-merge-state.schema.json's row shape -- ConvertTo-ProjectDUsageExportBatch and Merge-ProjectDUsageExportBatch build their output objects from an explicit list of named fields, so this property is dropped by construction the moment a ledger event crosses either boundary, never carried through.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^acct_[a-f0-9]{32}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^dev_[a-f0-9]{32}$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "textObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "modelObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "tokenObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "costObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "captured_at",
        "provider",
        "verification_status",
        "account_id",
        "account_alias",
        "device_id",
        "environment",
        "billing_source",
        "plan_type"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "provider": { "$ref": "#/$defs/provider" },
        "verification_status": {
          "enum": ["verified", "unknown", "mismatch"]
        },
        "account_id": {
          "oneOf": [
            { "$ref": "#/$defs/accountId" },
            { "type": "null" }
          ]
        },
        "account_alias": {
          "oneOf": [
            { "$ref": "#/$defs/alias" },
            { "type": "null" }
          ]
        },
        "device_id": { "$ref": "#/$defs/deviceId" },
        "environment": { "enum": ["work", "home", "other"] },
        "billing_source": {
          "enum": [
            "subscription",
            "api-key",
            "third-party-cloud",
            "unavailable"
          ]
        },
        "plan_type": { "$ref": "#/$defs/textObservation" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verification_status": { "const": "verified" } }
          },
          "then": {
            "properties": {
              "account_id": { "$ref": "#/$defs/accountId" },
              "account_alias": { "$ref": "#/$defs/alias" }
            }
          },
          "else": {
            "properties": {
              "account_id": { "type": "null" },
              "account_alias": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
