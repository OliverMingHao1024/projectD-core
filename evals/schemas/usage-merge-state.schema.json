{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectd.local/schemas/usage-merge-state.schema.json",
  "title": "projectD durable cross-device usage merge state",
  "description": "Local, git-ignored accumulator that merges already-gated usage-export-batch documents from multiple devices. Never shared or synced between devices directly; each device produces its own export batches (see usage-export-batch.schema.json), and this state is built by replaying those batches through the merge tool. Replaying the same batch (identified by its content digest) more than once must not change totals. Each totals row carries the originating batch's reporting period so date-bucketed reports (see usage-report.schema.json) keep working after a merge -- operators are expected to run the export gate once per reporting period (e.g. daily) so period boundaries stay meaningful.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "consumed_batches", "totals"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "consumed_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_digest",
          "device_id",
          "environment",
          "period",
          "source_version",
          "merged_at"
        ],
        "properties": {
          "batch_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "device_id": { "type": "string", "pattern": "^dev_[a-f0-9]{32}$" },
          "environment": { "enum": ["work", "home", "other"] },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" }
            }
          },
          "source_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "merged_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "totals": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "provider",
        "model",
        "device_id",
        "environment",
        "period",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_creation_tokens",
        "estimated_cost_usd",
        "run_count"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "provider": { "enum": ["codex", "claude"] },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "device_id": { "type": "string", "pattern": "^dev_[a-f0-9]{32}$" },
        "environment": { "enum": ["work", "home", "other"] },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        },
        "run_count": { "type": "integer", "minimum": 1 },
        "input_tokens": { "$ref": "#/$defs/metric" },
        "cached_input_tokens": { "$ref": "#/$defs/metric" },
        "output_tokens": { "$ref": "#/$defs/metric" },
        "reasoning_tokens": { "$ref": "#/$defs/metric" },
        "cache_creation_tokens": { "$ref": "#/$defs/metric" },
        "estimated_cost_usd": { "$ref": "#/$defs/metric" }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "unavailable" },
            "value": { "type": "null" }
          }
        }
      ]
    }
  }
}
