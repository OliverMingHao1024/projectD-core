{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/scripts/governance-host-operation-hook.ps1\" -HostName codex",
            "commandWindows": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel).Trim(); & $root/scripts/governance-host-operation-hook.ps1 -HostName codex -ProjectRoot $root\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/scripts/governance-command-policy-hook.ps1\" -ProjectRoot \"$(git rev-parse --show-toplevel)\"",
            "commandWindows": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel).Trim(); & $root/scripts/governance-command-policy-hook.ps1 -ProjectRoot $root\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$(git rev-parse --show-toplevel)/scripts/governance-host-operation-hook.ps1\" -HostName codex",
            "commandWindows": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -NoProfile -NonInteractive -Command \"$root=(git rev-parse --show-toplevel).Trim(); & $root/scripts/governance-host-operation-hook.ps1 -HostName codex -ProjectRoot $root\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
