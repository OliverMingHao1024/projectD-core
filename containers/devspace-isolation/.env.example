# Copy this file to .env (not committed) and fill in real values.

# One host repo path per repo this container serves. The var name after
# DEVSPACE_REPO_PATH_ must match the corresponding volume line in
# docker-compose.yml (case-insensitive on Windows, but keep them matching
# exactly). To add another repo: add a new DEVSPACE_REPO_PATH_<NAME> line
# here AND a matching `${DEVSPACE_REPO_PATH_<NAME>}:/repos/<name>:rw` volume
# line in docker-compose.yml, then `docker compose up -d`.
DEVSPACE_REPO_PATH_PROJECTD_CORE=D:/workspaces/projectD-core
DEVSPACE_REPO_PATH_CHOUTEN_COURT=D:/workspaces/chouten-court
DEVSPACE_REPO_PATH_PROJECTD_KNOWLEDGE=D:/workspaces/projectD-knowledge

# Long random secret DevSpace uses as the Owner password for MCP client
# approval (docs/security.md, "Owner Password"). Generate one, e.g.:
#   openssl rand -base64 32
DEVSPACE_OAUTH_OWNER_TOKEN=replace-with-a-long-random-value

# Public HTTPS origin of whatever tunnel/reverse proxy you point at
# 127.0.0.1:7676 on the host (DevSpace does not manage tunnels itself --
# see README.md). Leave blank for local-only testing with no tunnel.
DEVSPACE_PUBLIC_BASE_URL=
