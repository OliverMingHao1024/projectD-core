{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "projectD Skill Registry",
  "type": "object",
  "required": ["schema_version", "sources", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "repository",
          "license_spdx",
          "migration_status",
          "decision_records"
        ],
        "properties": {
          "provider": {"enum": ["github", "skill-vault"]},
          "latest_observed_version": {"type": ["integer", "null"]}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "source_path",
          "lifecycle_status",
          "decision_record",
          "migration_status"
        ],
        "properties": {
          "observed_version": {"type": ["integer", "null"]},
          "archive_digest": {"type": ["string", "null"]}
        }
      }
    }
  }
}
